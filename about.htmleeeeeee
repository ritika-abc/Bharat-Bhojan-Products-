<main>

<section class="page-hero">
  <div class="container-fluid-custom">
    <span class="breadcrumb-mono">Home / About Us</span>
    <h1>Rooted in India. Connected to the World.</h1>
    <p class="lead">BALAJEE ENTERPRISES works at the intersection of Indian agriculture and international trade, preparing spices and produce for buyers who value consistency and clear communication.</p>
  </div>
</section>

<!-- COMPANY INTRODUCTION -->
<section class="section">
  <div class="container-fluid-custom">
    <div class="row g-5 align-items-center">
      <div class="col-lg-6">
        <span class="eyebrow">Our Story</span>
        <h2>An Export Business Built on Indian Agriculture</h2>
        <p class="lead" data-aos="fade-up">BALAJEE ENTERPRISES is an Indian agricultural and food-spice export business, working to connect the country's produce and spices with buyers across the world.</p>
        <p data-aos="fade-up">Based out of Kolkata, West Bengal, the company is led by Kaushal Sethia, Head of Business Development, who works directly with international buyers to understand requirements and coordinate accordingly.</p>
        <p data-aos="fade-up">Our sourcing philosophy is simple: work close to origin, prepare products with care, and communicate clearly with every buyer throughout the process.</p>
      </div>
      <div class="col-lg-6">
        <div class="image-reveal image-3d" style="height:520px;">
          <div class="reveal-mask"></div>
          <img src="assets/images/about-hero.jpg" alt="Spices and agricultural produce ready for export"
               onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1596040033229-a9821ebd058d?q=80&w=1200&auto=format&fit=crop';">
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SOURCING / QUALITY / EXPORT PHILOSOPHY -->
<section class="section section-alt">
  <div class="container-fluid-custom">
    <div class="section-head mx-auto text-center">
      <span class="eyebrow">What Guides Us</span>
      <h2>Our Approach to Business</h2>
    </div>
    <div class="feature-grid" style="--tw:0;">
      <div class="feature-card" style="border-color:var(--line);background:var(--surface-card);" data-aos="fade-up" data-aos-delay="0">
        <i class="bi bi-geo-alt" style="color:var(--spice);"></i>
        <h3 style="color:var(--ink);">Agricultural Sourcing</h3>
        <p style="color:var(--ink-soft);">Products sourced with attention to origin and consistency, prepared for the requirements of export buyers.</p>
      </div>
      <div class="feature-card" style="border-color:var(--line);background:var(--surface-card);" data-aos="fade-up" data-aos-delay="80">
        <i class="bi bi-patch-check" style="color:var(--spice);"></i>
        <h3 style="color:var(--ink);">Product Quality Focus</h3>
        <p style="color:var(--ink-soft);">Every batch is prepared with care, aiming for the consistency that regular buyers depend on.</p>
      </div>
      <div class="feature-card" style="border-color:var(--line);background:var(--surface-card);" data-aos="fade-up" data-aos-delay="160">
        <i class="bi bi-globe2" style="color:var(--spice);"></i>
        <h3 style="color:var(--ink);">Export-Oriented Approach</h3>
        <p style="color:var(--ink-soft);">Coordination is built around what international shipping and buyer requirements actually need.</p>
      </div>
      <div class="feature-card" style="border-color:var(--line);background:var(--surface-card);" data-aos="fade-up" data-aos-delay="240">
        <i class="bi bi-chat-dots" style="color:var(--spice);"></i>
        <h3 style="color:var(--ink);">Customer Communication</h3>
        <p style="color:var(--ink-soft);">Buyers are kept informed and consulted, so requirements are understood clearly from the start.</p>
      </div>
    </div>
  </div>
</section>

<!-- OUR APPROACH — PROCESS -->
<section class="section">
  <div class="container-fluid-custom">
    <div class="row g-5">
      <div class="col-lg-5">
        <span class="eyebrow">How We Work</span>
        <h2>Our Approach</h2>
        <p class="lead" data-aos="fade-up">A clear, repeatable process keeps every order moving from Indian origin to the buyer's market, with quality checked at every stage.</p>
      </div>
      <div class="col-lg-7">
        <div class="process-track">
          <div class="process-step" data-aos="fade-up">
            <div class="process-num">01</div>
            <div class="process-copy"><h3>Product Sourcing</h3><p>Agricultural products and spices are sourced with attention to origin and consistency.</p></div>
          </div>
          <div class="process-step" data-aos="fade-up">
            <div class="process-num">02</div>
            <div class="process-copy"><h3>Quality Focus</h3><p>Products are checked for consistency before moving further into the process.</p></div>
          </div>
          <div class="process-step" data-aos="fade-up">
            <div class="process-num">03</div>
            <div class="process-copy"><h3>Preparation</h3><p>Products are prepared and packed according to the buyer's stated requirements.</p></div>
          </div>
          <div class="process-step" data-aos="fade-up">
            <div class="process-num">04</div>
            <div class="process-copy"><h3>Export Coordination</h3><p>Shipping and documentation are coordinated to keep the order on track.</p></div>
          </div>
          <div class="process-step" data-aos="fade-up">
            <div class="process-num">05</div>
            <div class="process-copy"><h3>Global Delivery</h3><p>The order is followed through to delivery, with communication kept open throughout.</p></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

