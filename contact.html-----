          <li><a data-config-email href="mailto:"><i class="bi bi-envelope me-2"></i>Kaushalsethiaa10@gmail.com</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© <span data-config-year>2026</span> Balajee Enterprises. All rights reserved.</span>
      <span>Indian Agricultural &amp; Spice Exports</span>
    </div>
  </div>
